<Window x:Class="Galpones.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Galpones.Desktop.Controls"
 Title="MakerGalpones · Estudio de proyecto" Width="1380" Height="900" MinWidth="1080" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#F3F6F6" Closing="Window_Closing" Style="{StaticResource {x:Type Window}}">
 <Grid Background="#F3F6F6">
  <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#152F39" Padding="20,28">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <Border Background="#2B4A51" CornerRadius="8" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,14"><TextBlock Text="M" FontWeight="Bold" FontSize="25" Foreground="#8BE3C8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
     <TextBlock Text="MakerGalpones" Foreground="White" FontSize="17" FontWeight="SemiBold" />
     <TextBlock Text="ESTUDIO DE PROYECTO" Foreground="#9AB2BB" FontSize="9" Margin="0,6,0,34" />
     <TextBlock Text="ESPACIO DE TRABAJO" Foreground="#9AB2BB" FontSize="9" Margin="0,0,0,12" />
     <Button Content="01   Diseño" Click="Design_Click" Margin="0,0,0,8" Background="#254953" Foreground="White" BorderBrush="#3A5D65" HorizontalContentAlignment="Left" />
     <Button Content="02   Revisión" Click="Review_Click" Margin="0,0,0,8" Background="#254953" Foreground="White" BorderBrush="#3A5D65" />
     <Button Content="03   Entrega" Click="Delivery_Click" Background="#254953" Foreground="White" BorderBrush="#3A5D65" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Border BorderBrush="#36505A" BorderThickness="0,1,0,0" Padding="0,16,0,0"><TextBlock Text="BASE PARAMÉTRICA" Foreground="#88D6C5" FontSize="10" /></Border>
     <TextBlock Text="Nave rectangular&#10;Pórticos metálicos" Foreground="#C0D1D7" Margin="0,8,0,18" FontSize="12" />
     <TextBlock Text="Desktop · v0.1" Foreground="#9AB2BB" FontSize="11" />
    </StackPanel>
    <Border />
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,24,26,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="DEL REQUISITO AL MODELO" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="Bold" /><TextBlock Text="{Binding ProjectTitle}" FontSize="25" FontWeight="SemiBold" Margin="0,5,14,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Nuevo" Click="New_Click" Margin="0,0,8,0"/><Button Content="Abrir proyecto" Click="Open_Click" Margin="0,0,8,0"/><Button Content="Guardar" Click="Save_Click" Style="{StaticResource Primary}"/></StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#E5EFED" CornerRadius="6" Padding="12,9" Margin="0,0,0,16"><DockPanel><TextBlock Text="BORRADOR" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,2,14,0" /><TextBlock Text="Configurá la nave, revisá la estructura y prepará el proyecto para Revit." Foreground="#365B59" FontSize="12" /></DockPanel></Border>
   <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
    <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>
    <TabItem Header="Diseño">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="335"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12"/>
          <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate>
           <Grid Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,5"><TextBlock Text="{Binding Unit}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding Label}" FontSize="12"/></DockPanel>
            <TextBox Grid.Row="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
           </Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
       <Button Grid.Row="1" Content="Actualizar modelo" Click="Generate_Click" Style="{StaticResource Primary}" Margin="0,8,8,0" Padding="18,13"/>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <UniformGrid Columns="4" Margin="0,0,0,14">
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="SUPERFICIE" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Area}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="m² de planta" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="PÓRTICOS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Frames}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="a lo largo de la nave" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="COLUMNAS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Columns}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="elementos" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="VIGAS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Beams}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="elementos" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
       </UniformGrid>
       <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><RadioButton x:Name="AxonButton" Content="Axonométrica" IsChecked="True" Checked="ViewMode_Changed" Margin="0,0,14,0"/><RadioButton x:Name="PlanButton" Content="Planta" Checked="ViewMode_Changed"/></StackPanel><TextBlock Text="Vista del modelo" FontWeight="SemiBold" FontSize="15"/></DockPanel>
         <TextBlock Grid.Row="1" Text="La vista muestra ejes y pórticos. Geometría relativa, sin implantación." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
         <controls:StructurePreview x:Name="Preview" Grid.Row="2" Model="{Binding Model}" Margin="0,10" ClipToBounds="True"/>
         <StackPanel Grid.Row="3"><TextBlock Text="{Binding PreviewCaption}" FontSize="12" Foreground="{StaticResource Muted}"/><Border Background="#FFF2DA" CornerRadius="4" Padding="9" Margin="0,9,0,0" Visibility="{Binding IsStale, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Vista pendiente de actualización. Aplicá los cambios para ver el resultado actual." FontSize="11" Foreground="#8A5916"/></Border></StackPanel>
        </Grid>
       </Border>
       <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0"><DockPanel><Button Content="Preparar para Revit →" Click="Prepare_Click" DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Continuá el proyecto en Revit" FontWeight="SemiBold"/><TextBlock Text="Guardá los requisitos y generá con las familias del proyecto de destino." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
      </Grid>
     </Grid>
    </TabItem>
    <TabItem Header="Revisión">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16"><Button Content="Actualizar revisión" Click="Generate_Click" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Revisión del proyecto" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Controles disponibles y decisiones que requieren intervención profesional." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReviewItems}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource Card}" Margin="0,0,10,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Estado}" Foreground="#9A671E" FontSize="10" FontWeight="Bold" Margin="0,3,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Detalle}" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Fuente}" Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource Accent}"/></StackPanel></Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </Grid>
    </TabItem>
    <TabItem Header="Entrega">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="850" HorizontalAlignment="Left">
      <TextBlock Text="Llevá el proyecto a Revit" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Esta primera conexión utiliza un archivo de proyecto compartido con el add-in existente." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="01   Guardá los requisitos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="El archivo conserva las dimensiones, familias y requisitos técnicos. Podés volver a abrirlo en MakerGalpones." Margin="0,10,0,14" Foreground="{StaticResource Muted}"/><WrapPanel><Button Content="Guardar proyecto" Click="Save_Click" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button Content="Guardar como…" Click="SaveAs_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding FileLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="02   Generá desde Revit 2025" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Abrí un proyecto con plantilla estructural. En Galpones → Generar galpón, seleccioná el archivo guardado y elegí las familias. Podés cargar archivos .rfa desde una carpeta «familias» junto al proyecto." Foreground="{StaticResource Muted}" Margin="0,10,0,12"/><Border Background="#FFF3DD" CornerRadius="5" Padding="12"><TextBlock Text="Usá un documento de trabajo nuevo: esta versión crea elementos y todavía no actualiza un modelo existente ni recupera cambios realizados en Revit." Foreground="#815D29"/></Border></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="03   Exportá material de revisión" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Compartí el resumen de comprobaciones o exportá la geometría del modelo intermedio." Foreground="{StaticResource Muted}" Margin="0,10,0,14"/><WrapPanel><Button Content="Exportar revisión (.md)" Click="ExportReview_Click" Margin="0,0,10,8"/><Button Content="Exportar modelo (.json)" Click="ExportModel_Click" Margin="0,0,0,8"/></WrapPanel><Button Content="Ver documento de trabajos pendientes" Click="WorkPlan_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
   </TabControl>
   <Border Grid.Row="3" BorderBrush="#DAE3E5" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
  </Grid>
 </Grid>
</Window>
